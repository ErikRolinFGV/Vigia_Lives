# Chave da YouTube Data API v3. Veja o README para gerar.
YT_API_KEY=cole_sua_chave_aqui

# Gerado automaticamente na primeira execucao. NAO apague nem troque:
# o salt define o pseudonimo de cada autor, e trocar ele zera o historico.
# PID_SALT=

# Opcional
# DB_PATH=data/lives.db

# Entrar com o Google (opcional). Sem estas duas, a tela pede so usuario e senha.
# No Google Cloud: credencial OAuth do tipo Aplicativo da Web, com o URI de
# redirecionamento http://localhost:8000/api/auth/google/retorno (e o do servidor).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# URL_PUBLICA=https://lively.app.br
